# ai-service config template — COPY sang .env rồi điền giá trị thật.
# .env đã được gitignore; KHÔNG commit secret vào file .example này.

engine=multiagent
gemini_api_key=your-gemini-api-key
llm_model=gemini-2.0-flash
embedding_model=text-embedding-004
llm_temperature=0.3
chroma_persist_dir=./data/chroma_db

# MySQL — local dev để 127.0.0.1; Aiven điền host/port/user/pass thật + mysql_ssl=true
mysql_host=127.0.0.1
mysql_port=3306
mysql_user=root
mysql_password=
mysql_database=banh_store
mysql_ssl=false
mysql_ssl_ca=

internal_api_secret=change-me-must-match-php
internal_order_api_url=http://localhost/cakev0/api/internal/orders/create.php
handoff_confidence_threshold=0.6

# Facebook Messenger (để trống nếu chưa dùng)
fb_page_token=
fb_verify_token=
fb_app_secret=

cors_origins=
site_base_url=https://cake-i8l0.onrender.com/cakev0
enable_normalizer=true
