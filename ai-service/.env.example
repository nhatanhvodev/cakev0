# ai-service Environment Variables
# Copy this file to .env and fill in the actual values

# LLM Configuration
GOOGLE_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-004
LLM_TEMPERATURE=0.3

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=password
DB_NAME=gau_bakery

# Vector Store (ChromaDB)
CHROMADB_PATH=./chromadb

# Engine Selection
ENGINE=baseline

# API Configuration
INTERNAL_API_SECRET=change-me-must-match-php
INTERNAL_ORDER_API_URL=http://localhost/cakev0/api/internal/orders/create.php
HANDOFF_CONFIDENCE_THRESHOLD=0.6

# Facebook Messenger (optional)
FB_PAGE_TOKEN=
FB_VERIFY_TOKEN=
FB_APP_SECRET=

# CORS Configuration
CORS_ORIGINS=
SITE_BASE_URL=https://cake-i8l0.onrender.com/cakev0

# Feature Flags
ENABLE_NORMALIZER=true
